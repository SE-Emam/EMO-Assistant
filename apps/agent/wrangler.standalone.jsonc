// One-Worker deployment, without Pages: the agent Worker also serves the web UI.
// Build the UI first (npm run build -w @emo/web), then set the OWNER_PASSWORD
// (or OWNER_PASSWORD_HASH) and SESSION_SECRET secrets. VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY
// turn on push notifications (optional; see docs/deployment.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "emo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "EmoAgent", "class_name": "EmoAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EmoAgent"] }],
  "observability": { "enabled": true }
}
